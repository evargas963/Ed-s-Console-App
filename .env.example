# EdWebConsole — local environment template
# Copy to .env in repo root and set values. NEVER commit .env (see .gitignore).
#
# Full reference: docs/host/ENVIRONMENT_VARIABLES.md

# ── Database ─────────────────────────────────────────────────────────────
# ED_CONSOLE_DB=data/ed_console.db
# ED_CONSOLE_ALLOW_NONCANONICAL_DB=0

# ── Console server ───────────────────────────────────────────────────────
ED_CONSOLE_PORT=8000
# ED_CONSOLE_RELOAD_URL=http://127.0.0.1:8000/api/internal/reload_models
# ED_CONSOLE_RELOAD_TOKEN=
# ED_ALLOW_ACTIVE_SYNC=0
# ED_DB_SNAPSHOT_THROTTLE=1

# ── Training / scheduler auto-promote (PR4) ───────────────────────────────
# Leave off until preflip e2e + live reload verified on this host.
ED_SCHEDULER_AUTO_PROMOTE=0
ED_DISABLE_AUTO_PROMOTE=0
ED_SCHEDULER_AUTO_PROMOTE_CORE_ONLY=1
ED_SCHEDULER_AUTO_PROMOTE_REQUIRE_VERIFY=1
ED_SCHEDULER_AUTO_PROMOTE_STRICT_CORE_FRESHNESS=0

# ── Inference strictness ─────────────────────────────────────────────────
ED_XGB_STRICT_ACTIVE_ONLY=1

# ── Calibration / ops (optional) ───────────────────────────────────────────
# ED_CALIBRATION_LOG=0
# ED_OPS_RUNNER=0
# ED_OPS_ALLOW_REMOTE=0

# ── Notifications (optional; URL is a secret) ───────────────────────────────
# ED_NOTIFICATION_WEBHOOK_ENABLED=0
# ED_NOTIFICATION_WEBHOOK_URL=

# ── Schwab (optional overrides; token file from: python reauth_schwab.py) ─
# SCHWAB_TOKEN_PATH=schwab_token.json
# SCHWAB_API_KEY=
# SCHWAB_APP_SECRET=
# SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
