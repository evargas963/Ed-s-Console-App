# EdWebConsole -- local environment template
# Copy to .env in the repo root and set values. NEVER commit .env (see .gitignore).
# Every variable here is read by the app; nothing else belongs in this file.

# -- Schwab (required for live data) -------------------------------------------
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
# SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# SCHWAB_TOKEN_PATH=C:\path\to\schwab_token.json

# -- Runtime state --------------------------------------------------------------
# Linked worktrees share the primary worktree's data directory. Set only to move all
# runtime state to a dedicated path outside any source worktree.
# ED_RUNTIME_ROOT=C:\path\to\runtime
