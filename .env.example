# EdWebConsole — local environment template
# Copy to .env in repo root and set values. NEVER commit .env (see .gitignore).
# Every variable the code reads is listed here; all are optional.

# ── Runtime state (runtime_layout.py) ────────────────────────────────────
# Linked worktrees share the primary checkout's data directory. Set only to move all runtime
# state (databases, token, logs) to a dedicated path outside any source worktree.
# ED_RUNTIME_ROOT=C:\path\to\dedicated\runtime
# ED_ARTIFACTS_ROOT=

# ── Database (db.py, db_authority.py, db_safety.py) ──────────────────────
# ED_CONSOLE_DB= / ED_DB_PATH=            another ed_console.db (tests)
# ED_CONSOLE_ALLOW_NONCANONICAL_DB=0      allow a database outside the runtime root (tests, CI)
# ED_CONSOLE_SQL_EXECUTE_GUARD=           / ED_CONSOLE_DANGEROUS_SQL_UNRESTRICTED=0
# ED_SQLITE_BUSY_RETRIES= ED_SQLITE_BUSY_BASE_SLEEP_SEC= ED_SQLITE_BUSY_MAX_SLEEP_SEC=
# ED_SQLITE_LOCK_WAIT_WARN_MS= ED_SQLITE_LOCK_WAIT_DISTRESS_MS= ED_SQLITE_LOCK_WAIT_DISTRESS_ATTEMPT=
# ED_SQLITE_WRITE_SLOW_MS=

# ── Capture daemon sockets (live_push.py, live_ui.py) ────────────────────
# ED_LIVE_PUSH_PORT=8799                  daemon -> console
# ED_LIVE_UI_HOST=127.0.0.1 ED_LIVE_UI_PORT=8800   daemon -> browser price rows

# ── Schwab (config.py, schwab_client.py; token file from: python reauth_schwab.py) ─
# SCHWAB_TOKEN_PATH=schwab_token.json
# SCHWAB_API_KEY=
# SCHWAB_APP_SECRET=
# SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# SCHWAB_OAUTH_CALLBACK_TIMEOUT_SEC=
# ED_SCHWAB_AUTH_FAILURE_LATCH_SEC=
# ED_CI_OFFLINE=1                          no Schwab calls (CI, tests)
