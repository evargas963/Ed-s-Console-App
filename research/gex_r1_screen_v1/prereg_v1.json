{
  "schema": "gex_r1_screen_prereg_v1",
  "card_id": "GEX-R1-SCREEN",
  "status": "SCREEN_NOT_VERDICT",
  "hypothesis": "0DTE dealer-gamma sign near the open separates mean-reversion days from trend days; conditioning VWAP-fade vs OR-breakout on gex_sign improves net expectancy after costs vs unconditional rules.",
  "tickers": ["SPY", "QQQ", "IWM"],
  "morning_window_et": {"start_mins": 570, "end_mins": 615},
  "signal": {
    "formula": "sum_calls(gamma*OI*100*S^2*0.01) - sum_puts(gamma*OI*100*S^2*0.01)",
    "gamma_source": "stored_contract_gamma",
    "sign_convention": "calls_positive_puts_negative_SqueezeMetrics_style_ASSUMPTION"
  },
  "rules": {
    "m_sigma": 1.0,
    "max_entries_per_day": 3,
    "or_minutes": 30,
    "or_buffer_sigma_frac": 0.1,
    "cost_round_trip_bp": 1.0,
    "stress_cost_mult": 2.0
  },
  "walk_forward": {
    "min_train_days": 20,
    "embargo_days": 1,
    "test_block_days": 5
  },
  "sample_floor_test_days": 40,
  "randomness": {"seed": 42},
  "limits": [
    "n~70/ticker over ~4 months = one narrow vol regime",
    "ATM 0DTE window only (~40 contracts)",
    "do not pool tickers as independent n",
    "not edge until Claude independent rebuild + verify"
  ]
}
