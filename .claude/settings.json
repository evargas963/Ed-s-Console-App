{
  "_comment": "Hook wiring only. Each guard file IS its own authority and documents why it exists; this file decides which guards run on which event. tools/hook_chain.py runs the listed guards in one process from THIS checkout; nothing is remembered between events (RC-544).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe tools/hook_chain.py tools/operator_law_guard.py tools/process_lock_guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe tools/hook_chain.py tools/operator_law_guard.py tools/process_lock_guard.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe tools/hook_chain.py tools/stop_guard.py"
          }
        ]
      }
    ]
  }
}
