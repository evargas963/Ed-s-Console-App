{
  "_comment": "Hook wiring only: which guards run on which event. tools/hook_chain.py runs the listed guards in one process from this checkout; nothing is remembered between events.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe tools/hook_chain.py tools/operator_law_guard.py tools/process_lock_guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe tools/hook_chain.py tools/operator_law_guard.py tools/process_lock_guard.py"
          }
        ]
      }
    ]
  }
}
