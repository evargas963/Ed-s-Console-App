# Model artifacts — only models/active*/ are tracked
# Tracked production paths:
#   models/active/        (default fallback active)
#   models/active_5c/     (horizon-specific active)
#   models/active_15c/
#   models/active_60c/
# All other paths under models/ (candidate dirs, archives, caches, legacy flat files, run outputs, quarantine snapshots) are untracked.

models/**
